# Discord Bot Token (from Bot page)
# Get this from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Server ID (right-click server -> Copy Server ID)
DISCORD_GUILD_ID=123456789012345678

# Discord Voice Channel ID (right-click voice channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# Device name shown in Spotify Connect (default: Discord Player)
DEVICE_NAME=Discord Player

# Optional: stable device id to avoid duplicate devices (auto-generated if omitted)
DEVICE_ID=

# Audio buffer length in seconds (1-12, default: 8)
AUDIO_BUFFER_SECONDS=8

# Prebuffer time before audio starts in seconds (0.0-8.0, default: 2.0)
PREBUFFER_SECONDS=2.0

# Bass tuning (adjust to taste)
PREAMP_DB=0.0
BASS_BOOST_DB=0.0
TREBLE_BOOST_DB=0.0

# Logging level (default: warn)
#   Simple:  trace | debug | info | warn | error
#            Sets app crate to that level; dependencies stay at warn.
#   Custom:  any valid RUST_LOG filter string, e.g.:
#            RUST_LOG="debug,serenity=info,librespot=debug"
# RUST_LOG=warn
