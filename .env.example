# Discord Bot Token (from Bot page)
# Get this from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Server ID (right-click server -> Copy Server ID)
DISCORD_GUILD_ID=123456789012345678

# Discord Voice Channel ID (right-click voice channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# Spotify Credentials (optional; used only if you add password login)
SPOTIFY_USERNAME=your_spotify_username
SPOTIFY_PASSWORD=your_spotify_password

# Device name shown in Spotify Connect
DEVICE_NAME=Discord Player

# Optional: stable device id to avoid duplicate devices (auto-generated if omitted)
DEVICE_ID=

# Audio buffer length in seconds (higher = smoother, more latency)
AUDIO_BUFFER_SECONDS=10

# Prebuffer time before audio starts (adds latency, helps startup/pause stutters)
PREBUFFER_SECONDS=3.0

# Bass tuning (adjust to taste)
PREAMP_DB=0.0
BASS_BOOST_DB=0.0
TREBLE_BOOST_DB=0.0

# Logging level (trace, debug, info, warn, error)
# Tip: use RUST_LOG=trace for minimal app-only tracing (deps stay quiet).
RUST_LOG=trace
