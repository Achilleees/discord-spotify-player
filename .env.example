# Discord Bot Token (from Bot page)
# Get this from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Server ID (right-click server -> Copy Server ID)
DISCORD_GUILD_ID=123456789012345678

# Discord Voice Channel ID (right-click voice channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# Optional: text channel for now-playing embeds and playback controls
# (defaults to the voice channel's built-in text chat)
# TEXT_CHANNEL_ID=123456789012345678

# Encryption key for stored OAuth tokens at rest. Any long random string; it is
# hashed to a 32-byte key. If unset, tokens are stored unencrypted (with a
# startup warning). Strongly recommended on a shared/VPS host.
# TOKEN_ENC_KEY=change-me-to-a-long-random-string

# Path to the SQLite credential store (default: spotibot.db in the cwd).
# SPOTIBOT_DB=spotibot.db

# Optional instance root. Setting it moves all default media/cache paths under
# that root, relative to the working directory; no existing state is migrated.
# STATE_DIR=.local/spotibot-state
# DATABASE_PATH=spotibot.db   # relative to STATE_DIR, takes precedence over SPOTIBOT_DB
# SPOTIFY_CACHE_DIR=.spotify_cache
# The separate nob executable uses .env.nob.example and NOB_* process variables.

# Deployment paths (defaults target the VPS layout under /var/lib/spotibot).
# Override for a local run or a different host.
# YOUTUBE_TMP_DIR=/tmp/spotibot-youtube
# YOUTUBE_COOKIES=/var/lib/spotibot/youtube-cookies.txt   # yt-dlp cookies (Netscape format) — needed for age-restricted videos
# YOUTUBE_MAX_DURATION_SECS=7200   # max queue-able track length via /play (default 2h)
# DJ_CLIPS_DIR=/var/lib/spotibot/dj-clips
# DJ_CACHE_DIR=/var/lib/spotibot/dj-cache
# KOKORO_SOCKET=/var/lib/spotibot/kokoro.sock

# Device name shown in Spotify Connect (default: Discord Player)
DEVICE_NAME=Discord Player

# Optional: stable device id to avoid duplicate devices (auto-generated if omitted)
DEVICE_ID=

# Audio buffer length in seconds (1-12, default: 8)
AUDIO_BUFFER_SECONDS=8

# Prebuffer time before audio starts in seconds (0.0-8.0, default: 2.0)
PREBUFFER_SECONDS=2.0

# EQ / audio tuning (adjust to taste)
PREAMP_DB=0.0
BASS_BOOST_DB=0.0
TREBLE_BOOST_DB=0.0

# Logging level (default: warn)
#   Simple:  trace | debug | info | warn | error
#            Sets app crate to that level; dependencies stay at warn.
#   Custom:  any valid RUST_LOG filter string, e.g.:
#            RUST_LOG="debug,serenity=info,librespot=debug"
# RUST_LOG=warn

# Optional paired command surface: nob owns slash commands; Spotibot performs.
# Default standalone preserves the existing commands. Configure both hosts
# together, with the SAME random 64-hex-character ROUTING_KEY; see docs/two-bots.md.
# COMMAND_MODE=worker
# ROUTING_LISTEN=127.0.0.1:19211
# ROUTING_KEY=   # required in worker mode; distinct from TOKEN_ENC_KEY
