# Copy to .env.nob for the nob executable. Use a DIFFERENT Discord bot token.
# Keys in this file are unprefixed. Process environment overrides use NOB_*:
# e.g. NOB_DISCORD_TOKEN, NOB_STATE_DIR, NOB_DEVICE_NAME, NOB_RUST_LOG.
# Unprefixed process variables and Spotibot's .env are ignored by nob.
DISCORD_TOKEN=your-nob-bot-token
DISCORD_GUILD_ID=123456789012345678
DISCORD_CHANNEL_ID=123456789012345678
# TEXT_CHANNEL_ID=123456789012345678

DEVICE_NAME=nob
# Leave DEVICE_ID unset: nob generates and persists its own device identity.
# TOKEN_ENC_KEY=choose-a-separate-long-random-string

# Relative paths resolve beneath STATE_DIR; absolute paths remain absolute.
# STATE_DIR itself is relative to the process working directory.
# Default .nob is gitignored. Do not share writable state with Spotibot.
STATE_DIR=.nob
# DATABASE_PATH=nob.db
# SPOTIFY_CACHE_DIR=.spotify_cache
# YOUTUBE_TMP_DIR=youtube-tmp
# YOUTUBE_COOKIES=youtube-cookies.txt
# DJ_CLIPS_DIR=dj-clips
# DJ_CACHE_DIR=dj-cache
# KOKORO_SOCKET=kokoro.sock
# YOUTUBE_MAX_DURATION_SECS=7200

# Other shared audio/log settings work here, or as NOB_* process variables.
# AUDIO_BUFFER_SECONDS=8
# PREBUFFER_SECONDS=2.0
# PREAMP_DB=0.0
# BASS_BOOST_DB=0.0
# TREBLE_BOOST_DB=0.0
# RUST_LOG=warn

# Optional paired command surface: /play, /music and /server belong to nob.
# Default standalone preserves each bot's existing commands.
# COMMAND_MODE=coordinator
# ROUTING_LISTEN=127.0.0.1:19212
# ROUTING_PEER=127.0.0.1:19211
# ROUTING_KEY=   # same random 64-hex-character key as Spotibot; see docs/two-bots.md
# Process overrides are NOB_COMMAND_MODE, NOB_ROUTING_LISTEN, etc.
